@baseUrl = http://localhost:3001
@userId = 69abcf126a23db22a37e4cea
@tokenaccess = 
@tokenrefresh = 
### USER API-----------------------------------------------------------------


### Create a new user
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "test1",
  "email": "test1@example.com",
  "password": "test1"
}

### Get all users
GET {{baseUrl}}/users
Cookie: accessToken={{tokenaccess}}; refreshToken={{tokenrefresh}}

### Get a user by id
GET {{baseUrl}}/users/{{userId}}
Cookie: accessToken={{tokenaccess}}
### Update a user by id
PATCH {{baseUrl}}/users/{{userId}}
Content-Type: application/json
Cookie: accessToken={{tokenaccess}}

{
  "role": "admin"
}

### Delete a user by id
DELETE {{baseUrl}}/users/{{userId}}
Cookie: accessToken={{tokenaccess}}



### AUTH API-----------------------------------------------------------------



### Register a new user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "testing1",
  "email": "tophits2031@gmail.com",
  "password": "passwordtest2",
  "phone": "9876543211",
  "role": "user"
}

### Verify email for a user
POST {{baseUrl}}/auth/verify-email
Content-Type: application/json

{
  "email": "appmyfirst67@gmail.com",
  "otp": "228478"
}


### Resend OTP for email verification
POST {{baseUrl}}/auth/resend-otp
Content-Type: application/json

{
  "email": "appmyfirst67@gmail.com"
}

### Forgot password for a user
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "bikrammodi132@gmail.com"
}

### verify OTP for password reset
POST {{baseUrl}}/auth/verify-reset-otp
Content-Type: application/json

{
  "email": "bikrammodi132@gmail.com",
  "otp": "287878"
}


### Reset password for a user
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json

{
    "resetToken":"6d84a7f33fd5c3a6c5fc995f722b2af89a41b9ab1148762b77024c905b2fd7b4",
    "password":"NewPassword123",
    "confirmPassword":"NewPassword123"
}

### Login a user
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "bikrammodi132@gmail.com",
  "password": "NewPassword123"
}

### Logout a user
POST {{baseUrl}}/auth/logout
Content-Type: application/json
Cookie: accessToken={{tokenaccess}}

### Refresh access token
POST {{baseUrl}}/auth/refresh
Content-Type: application/json
Cookie: accessToken={{tokenaccess}}; refreshToken={{tokenrefresh}}

### Get current user profile
GET {{baseUrl}}/auth/me
Content-Type: application/json
Cookie: accessToken={{tokenaccess}}; refreshToken={{tokenrefresh}}






