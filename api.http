###############################################################
# Gemma 3 1B
###############################################################

POST {{baseUrl}}/ai/chat
Content-Type: application/json

{
    "model": "gemma3:1b",
    "prompt": "Introduce yourself in one paragraph."
}

### Generate AI Response

POST {{baseUrl}}/ai/chat/gen-ai
Content-Type: application/json

{
    "message": "Explain RAG"
    
}

### Generate RAG Response

POST {{baseUrl}}/ai/chat/rag-ai
Content-Type: application/json

{
    "message": "Explain Bikram projects?"
    
}

### Generate Agentic Response
POST {{baseUrl}}/ai/chat/agentic-ai
Content-Type: application/json

{
    "message": "calculate 3+6"
    
}



### Upload Document
POST {{baseUrl}}/documents/upload
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="w3.pdf"
Content-Type: application/pdf

< ./src/test-data/w3.pdf
------WebKitFormBoundary7MA4YWxkTrZu0gW--






















